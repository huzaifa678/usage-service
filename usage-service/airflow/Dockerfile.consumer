FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce

RUN apt-get update && apt-get install -y gcc librdkafka-dev git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY usage_common/ usage_common/
COPY etl/ etl/
COPY airflow/avro/ avro/

ENV PYTHONUNBUFFERED=1
ENV AVRO_SCHEMA_PATH=/app/avro/usage_event.avsc

CMD ["python", "-c", "from etl.ingest import consume_kafka_batch; consume_kafka_batch()"]
